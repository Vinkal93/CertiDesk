rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }
    
    function isTenantAdmin(instituteId) {
      return isAuthenticated() && (request.auth.token.instituteId == instituteId || isSuperAdmin());
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Institutes collection
    match /institutes/{instituteId} {
      allow read: if isTenantAdmin(instituteId);
      allow update: if isTenantAdmin(instituteId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'status']);
      allow create, delete: if isSuperAdmin();

      // Institute settings subcollection
      match /settings/{settingId} {
        allow read, write: if isTenantAdmin(instituteId);
      }

      // Institute student login accounts subcollection
      match /student_accounts/{accountUid} {
        allow read, write: if isTenantAdmin(instituteId);
      }
    }

    // Students collection - strict tenant boundary
    match /students/{studentId} {
      allow read, create, update, delete: if isTenantAdmin(resource.data.instituteId || request.resource.data.instituteId);
    }

    // Batches collection
    match /batches/{batchId} {
      allow read, write: if isTenantAdmin(resource.data.instituteId || request.resource.data.instituteId);
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isTenantAdmin(resource.data.instituteId);
    }

    // Certificates collection
    match /certificates/{certificateId} {
      allow read: if true; // Public verification allowed
      allow write: if isTenantAdmin(resource.data.instituteId || request.resource.data.instituteId);
    }

    // Marksheets collection
    match /marksheets/{marksheetId} {
      allow read: if true; // Public verification allowed
      allow write: if isTenantAdmin(resource.data.instituteId || request.resource.data.instituteId);
    }

    // Wallet Transactions - Immutable ledger, never modified directly from client
    match /walletTransactions/{txId} {
      allow read: if isTenantAdmin(resource.data.instituteId);
      allow write: if false; // Only written via Cloud Functions or Admin SDK
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isTenantAdmin(resource.data.instituteId);
      allow write: if false; // Server-only
    }

    // Platform audit logs (Super Admin & Server-only)
    match /platform_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Server-only
    }
  }
}
